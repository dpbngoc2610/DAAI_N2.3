# Copy this connection to the Snowflake connections.toml location for your OS.
# Keep the real PAT outside the project and do not commit its contents.

[student_sales]
account = "<organization-account>"
user = "<user>"
authenticator = "PROGRAMMATIC_ACCESS_TOKEN"
token_file_path = "C:/absolute/path/outside/project/snowflake.pat"
role = "<role-with-create-database-and-warehouse-privileges>"
warehouse = "STUDENT_SALES_ETL_WH"
database = "STUDENT_SALES_DW"
schema = "CONTROL"
