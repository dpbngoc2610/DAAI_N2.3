
from __future__ import annotations

from pathlib import Path

import pandas as pd

BRONZE_PATH = Path("bronze/inventory.csv")
REPORT_DIR = Path("silver/_reports")
REPORT_MD = REPORT_DIR / "inventory_dq_report.md"
ISSUES_CSV = REPORT_DIR / "inventory_dq_issues.csv"

KEY_COLS = ["snapshot_date", "product_id"]
QTY_COLS = ["stock_on_hand", "units_received", "units_sold", "stockout_days"]
RATE_COLS = ["fill_rate", "sell_through_rate"]

lines: list[str] = []


def log(text: str = "") -> None:
    print(text)
    lines.append(text)


def section(title: str) -> None:
    log()
    log(f"## {title}")
    log()


def check_negative(df: pd.DataFrame) -> pd.DataFrame:
    section("1. Kiem tra gia tri am")
    rows = []
    for col in QTY_COLS:
        n = int((df[col] < 0).sum())
        log(f"- `{col}`: {n} dong am")
        if n:
            bad = df[df[col] < 0]
            rows.append(pd.DataFrame({"check": "negative_value", "column": col,
                                       "product_id": bad["product_id"], "snapshot_date": bad["snapshot_date"],
                                       "value": bad[col], "note": "Gia tri am khong hop le"}))
    return pd.concat(rows, ignore_index=True) if rows else pd.DataFrame()


def check_duplicate_key(df: pd.DataFrame) -> pd.DataFrame:
    section("2. Kiem tra khoa (snapshot_date, product_id)")
    dup = df.duplicated(subset=KEY_COLS, keep=False)
    log(f"- Tong so dong: {len(df)}")
    log(f"- So to hop khoa distinct: {df.drop_duplicates(subset=KEY_COLS).shape[0]}")
    log(f"- So dong trung khoa: {int(dup.sum())}")
    verdict = "DAT" if dup.sum() == 0 else "KHONG DAT"
    log(f"> Ket luan: (snapshot_date, product_id) {verdict} dieu kien khoa chinh cua bang fact.")
    bad = df[dup]
    return pd.DataFrame({"check": "duplicate_key", "column": "snapshot_date+product_id",
                          "product_id": bad["product_id"], "snapshot_date": bad["snapshot_date"],
                          "value": "", "note": "Trung khoa"})


def check_year_month_consistency(df: pd.DataFrame) -> pd.DataFrame:
    section("3. Kiem tra year/month co khop voi snapshot_date")
    dt = pd.to_datetime(df["snapshot_date"], errors="coerce")
    mismatch = dt.dt.year.ne(df["year"]) | dt.dt.month.ne(df["month"])
    log(f"- So dong khong parse duoc snapshot_date: {int(dt.isna().sum())}")
    log(f"- So dong year/month khong khop voi snapshot_date: {int(mismatch.sum())}")
    log(f"- Khoang thoi gian du lieu: {dt.min():%Y-%m} den {dt.max():%Y-%m}")
    bad = df[mismatch]
    return pd.DataFrame({"check": "year_month_mismatch", "column": "year/month",
                          "product_id": bad["product_id"], "snapshot_date": bad["snapshot_date"],
                          "value": bad["year"].astype(str) + "-" + bad["month"].astype(str),
                          "note": "Khong khop voi snapshot_date"})


def check_rate_columns(df: pd.DataFrame) -> pd.DataFrame:
    section("4. Kiem tra cot fill_rate / sell_through_rate (phai trong [0,1])")
    rows = []
    for col in RATE_COLS:
        out = ~df[col].between(0, 1)
        log(f"- `{col}`: min={df[col].min():.4f}, max={df[col].max():.4f}, "
            f"so dong ngoai [0,1]: {int(out.sum())}")
        if out.sum():
            bad = df[out]
            rows.append(pd.DataFrame({"check": f"{col}_out_of_range", "column": col,
                                       "product_id": bad["product_id"], "snapshot_date": bad["snapshot_date"],
                                       "value": bad[col], "note": "Ngoai [0,1]"}))
    return pd.concat(rows, ignore_index=True) if rows else pd.DataFrame()


def check_flag_consistency(df: pd.DataFrame) -> pd.DataFrame:
    section("5. Kiem tra mau thuan co: stockout_flag vs stockout_days")
    inconsistent = (
        (df["stockout_flag"].astype(bool) & df["stockout_days"].eq(0))
        | (~df["stockout_flag"].astype(bool) & df["stockout_days"].gt(0))
    )
    log(f"- So dong stockout_flag=1 nhung stockout_days=0: "
        f"{int((df['stockout_flag'].astype(bool) & df['stockout_days'].eq(0)).sum())}")
    log(f"- So dong stockout_flag=0 nhung stockout_days>0: "
        f"{int((~df['stockout_flag'].astype(bool) & df['stockout_days'].gt(0)).sum())}")
    log(f"- Tong so dong mau thuan: {int(inconsistent.sum())}")
    bad = df[inconsistent]
    return pd.DataFrame({"check": "flag_inconsistent", "column": "stockout_flag/stockout_days",
                          "product_id": bad["product_id"], "snapshot_date": bad["snapshot_date"],
                          "value": bad["stockout_flag"].astype(str) + "/" + bad["stockout_days"].astype(str),
                          "note": "Co va so ngay khong khop"})


def check_distinct_and_missing(df: pd.DataFrame) -> None:
    section("6. Kiem tra cac gia tri rieng biet + missing values toan bang")
    prof = pd.DataFrame({
        "cot": df.columns,
        "so_distinct": [df[c].nunique(dropna=False) for c in df.columns],
        "so_null": [int(df[c].isna().sum()) for c in df.columns],
    })
    log(prof.to_markdown(index=False))
    log()
    log(f"- So product_id distinct trong inventory: {df['product_id'].nunique()} "
        "(luu y: KHONG cung mien voi product_id trong epd.csv)")
    log(f"- So snapshot_date distinct: {df['snapshot_date'].nunique()}")


def main(bronze_path: Path = BRONZE_PATH) -> None:
    df = pd.read_csv(bronze_path, encoding="utf-8-sig")
    log(f"# BAO CAO CHAT LUONG DU LIEU - {bronze_path.name}")
    log()
    log(f"- Kich thuoc: {df.shape[0]} dong x {df.shape[1]} cot")
    log(f"- Ngay chay: {pd.Timestamp.today():%Y-%m-%d %H:%M}")

    i1 = check_negative(df)
    i2 = check_duplicate_key(df)
    i3 = check_year_month_consistency(df)
    i4 = check_rate_columns(df)
    i5 = check_flag_consistency(df)
    check_distinct_and_missing(df)

    non_empty = [x for x in [i1, i2, i3, i4, i5] if len(x)]
    issues = pd.concat(non_empty, ignore_index=True) if non_empty else pd.DataFrame(columns=["check", "product_id", "snapshot_date"])

    section("TONG HOP")
    if len(issues):
        log(issues.groupby("check").size().rename("so_dong_anh_huong").reset_index().to_markdown(index=False))
        log()
        log(f"- Tong so dong co it nhat 1 loi: {len(issues.drop_duplicates(subset=['product_id','snapshot_date']))} "
            f"/ {len(df)}")
    else:
        log("Khong phat hien loi nao.")

    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_MD.write_text("\n".join(lines), encoding="utf-8")
    issues.to_csv(ISSUES_CSV, index=False, encoding="utf-8-sig")
    print(f"\n-> Da ghi {REPORT_MD}\n-> Da ghi {ISSUES_CSV}")


if __name__ == "__main__":
    main()