

from __future__ import annotations

from pathlib import Path

import pandas as pd

# CAU HINH
BRONZE_PATH = Path("bronze/epd.csv")
REPORT_DIR = Path("silver/_reports")
REPORT_MD = REPORT_DIR / "epd_dq_report.md"
ISSUES_CSV = REPORT_DIR / "epd_dq_issues.csv"

PRIMARY_KEY = "product_id"
NUMERIC_COLS = ["product_id", "price", "cogs"]
VALID_CATEGORY = {"Streetwear", "Outdoor", "GenZ", "Casual"}
SENTINEL_TEXT = {"Unknown_999", "unknown", "N/A", "-1", "999"}
PRICE_UPPER_BOUND = 100_000    
RATIO_THRESHOLD = 100         

lines: list[str] = []           

def log(text: str = "") -> None:
    print(text)
    lines.append(text)


def section(title: str) -> None:
    log()
    log(f"## {title}")
    log()



# 1. GIA TRI AM

def check_negative_values(df: pd.DataFrame) -> pd.DataFrame:
    section("1. Kiem tra gia tri am")
    rows = []
    for col in NUMERIC_COLS:
        neg = df[df[col] < 0]
        log(f"- `{col}`: {len(neg)} dong co gia tri am")
        for _, r in neg.iterrows():
            rows.append({"check": "negative_value", "column": col,
                         PRIMARY_KEY: r[PRIMARY_KEY], "value": r[col],
                         "note": "Gia tri am khong hop le cho cot tien te/dinh danh"})
    if rows:
        log()
        log("Chi tiet:")
        log()
        log(pd.DataFrame(rows).to_markdown(index=False))
    return pd.DataFrame(rows)



# 2. COT CATEGORY

def check_category(df: pd.DataFrame) -> pd.DataFrame:
    section("2. Kiem tra cot Category")
    vc = df["category"].value_counts(dropna=False).rename_axis("category").reset_index(name="so_dong")
    vc["ty_le_pct"] = (vc["so_dong"] / len(df) * 100).round(2)
    vc["trang_thai"] = vc["category"].map(
        lambda v: "HOP LE" if v in VALID_CATEGORY
        else ("NULL" if pd.isna(v) else "GIA TRI RAC")
    )
    log(vc.to_markdown(index=False))
    log()
    log(f"- So gia tri distinct: {df['category'].nunique(dropna=False)} "
        f"(chi {len(VALID_CATEGORY)} gia tri thuc su hop le)")
    log(f"- So dong NULL: {df['category'].isna().sum()}")
    log(f"- So dong mang gia tri rac (sentinel): {df['category'].isin(SENTINEL_TEXT).sum()}")
    log()
    log("> Ket luan: `Unknown_999` la sentinel, phai quy ve NULL o tang silver, "
        "khong duoc coi la mot nganh hang khi group by o tang gold.")

    bad = df[df["category"].isna() | df["category"].isin(SENTINEL_TEXT)]
    return pd.DataFrame({
        "check": "invalid_category", "column": "category",
        PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad["category"],
        "note": "NULL hoac gia tri sentinel",
    })


# 3. COT PRODUCT NAME

def check_product_name(df: pd.DataFrame) -> pd.DataFrame:
    section("3. Kiem tra cot Product Name")
    total, distinct = len(df), df["product_name"].nunique()
    dup_names = df["product_name"].value_counts()
    dup_names = dup_names[dup_names > 1]

    log(f"- Tong so dong: {total}")
    log(f"- So ten distinct: {distinct}")
    log(f"- So ten bi lap: {len(dup_names)} ten, anh huong {int(dup_names.sum())} dong")
    log(f"- So dong NULL: {df['product_name'].isna().sum()}")
    log()
    log("Top ten bi lap nhieu nhat:")
    log()
    log(dup_names.head(10).rename_axis("product_name").reset_index(name="so_lan")
        .to_markdown(index=False))
    log()
    log("> Ket luan: cac dong trung ten VAN co product_id khac nhau nen day KHONG phai "
        "trung dong. Nhung tuyet doi khong duoc dung `product_name` lam khoa join.")

    bad = df[df["product_name"].isin(dup_names.index)]
    return pd.DataFrame({
        "check": "duplicate_product_name", "column": "product_name",
        PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad["product_name"],
        "note": "Ten san pham bi lap o nhieu product_id",
    })



# 4. GIA TRI RIENG BIET

def check_distinct(df: pd.DataFrame) -> None:
    section("4. Kiem tra cac gia tri rieng biet")
    prof = pd.DataFrame({
        "cot": df.columns,
        "kieu_du_lieu": [str(df[c].dtype) for c in df.columns],
        "so_distinct": [df[c].nunique(dropna=False) for c in df.columns],
        "so_null": [int(df[c].isna().sum()) for c in df.columns],
    })
    prof["ty_le_distinct_pct"] = (prof["so_distinct"] / len(df) * 100).round(2)
    prof["vai_tro"] = prof.apply(
        lambda r: "Khoa chinh" if r["so_distinct"] == len(df) and r["so_null"] == 0
        else ("Chieu phan loai" if r["so_distinct"] <= 20 else "Thuoc tinh"),
        axis=1,
    )
    log(prof.to_markdown(index=False))
    log()
    for col in ["category", "segment", "size", "color"]:
        vals = sorted(df[col].dropna().unique().tolist())
        log(f"- `{col}` ({len(vals)}): {', '.join(map(str, vals))}")



# 5. COT PRICE

def check_price(df: pd.DataFrame) -> pd.DataFrame:
    section("5. Kiem tra cot Price")
    price = df["price"]
    log(f"- So dong thieu (NULL): {price.isna().sum()}")
    log(f"- So dong <= 0: {int((price <= 0).sum())}")
    log(f"- So dong > {PRICE_UPPER_BOUND:,}: {int((price > PRICE_UPPER_BOUND).sum())}")
    log()
    stats = price.describe()[["mean", "50%", "min", "max"]].rename({"50%": "median"})
    log(stats.round(2).to_frame("gia_tri").to_markdown())
    log()
    log(f"> Canh bao: mean = {price.mean():,.0f} nhung median chi = {price.median():,.0f}. "
        "Chenh lech nay do gia tri rac keo len, nen dung MEDIAN khi bao cao gia trung binh.")

    ratio = df["price"] / df["cogs"].where(df["cogs"] > 0)
    bad = df[price.isna() | (price <= 0) | (price > PRICE_UPPER_BOUND) | (ratio > RATIO_THRESHOLD)]
    log()
    log("Cac dong co van de:")
    log()
    log(bad[[PRIMARY_KEY, "product_name", "category", "price", "cogs"]].to_markdown(index=False))

    return pd.DataFrame({
        "check": "price_issue", "column": "price",
        PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad["price"],
        "note": "NULL / am / vuot nguong / lech bat thuong so voi cogs",
    })



# 6. COT PRODUCT_ID

def check_product_id(df: pd.DataFrame) -> pd.DataFrame:
    section("6. Kiem tra cot Product_id")
    pid = df[PRIMARY_KEY]
    dup_count = int(pid.duplicated().sum())
    expected = set(range(int(pid.min()), int(pid.max()) + 1))
    missing = sorted(expected - set(pid.dropna().astype(int)))

    log(f"- Tong so dong: {len(df)}")
    log(f"- So gia tri distinct: {pid.nunique()}")
    log(f"- So dong bi trung: {dup_count}")
    log(f"- So dong NULL: {int(pid.isna().sum())}")
    log(f"- Khoang gia tri: {int(pid.min())} - {int(pid.max())}")
    log(f"- So id bi thieu trong day lien tuc: {len(missing)}")
    log()
    verdict = "DAT" if dup_count == 0 and pid.isna().sum() == 0 else "KHONG DAT"
    log(f"> Ket luan: `product_id` {verdict} dieu kien lam KHOA CHINH "
        "(duy nhat, khong NULL).")

    bad = df[pid.duplicated(keep=False) | pid.isna()]
    return pd.DataFrame({
        "check": "product_id_issue", "column": PRIMARY_KEY,
        PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad[PRIMARY_KEY],
        "note": "Trung hoac NULL",
    })


# MAIN
def main(bronze_path: Path = BRONZE_PATH) -> None:
    df = pd.read_csv(bronze_path, encoding="utf-8-sig")

    log(f"# BAO CAO CHAT LUONG DU LIEU - {bronze_path.name}")
    log()
    log(f"- Nguon: `{bronze_path}`")
    log(f"- Kich thuoc: {df.shape[0]} dong x {df.shape[1]} cot")
    log(f"- Ngay chay: {pd.Timestamp.today():%Y-%m-%d %H:%M}")

    neg_issues = check_negative_values(df)
    cat_issues = check_category(df)
    name_issues = check_product_name(df)
    check_distinct(df)                    
    price_issues = check_price(df)
    pid_issues = check_product_id(df)

    issues = pd.concat(
        [neg_issues, cat_issues, name_issues, price_issues, pid_issues], ignore_index=True
    )

    section("TONG HOP")
    summary = issues.groupby("check").size().rename("so_dong_anh_huong").reset_index()
    log(summary.to_markdown(index=False))
    log()
    log(f"- Tong so dong co it nhat 1 loi: {issues[PRIMARY_KEY].nunique()} / {len(df)} "
        f"({issues[PRIMARY_KEY].nunique() / len(df) * 100:.2f}%)")

    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_MD.write_text("\n".join(lines), encoding="utf-8")
    issues.to_csv(ISSUES_CSV, index=False, encoding="utf-8-sig")
    print(f"\n-> Da ghi {REPORT_MD}\n-> Da ghi {ISSUES_CSV}")


if __name__ == "__main__":
    main()