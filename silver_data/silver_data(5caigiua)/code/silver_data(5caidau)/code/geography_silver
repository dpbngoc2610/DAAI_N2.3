

from __future__ import annotations

from pathlib import Path

import pandas as pd

BRONZE_PATH = Path("bronze/geography.csv")
REPORT_DIR = Path("silver/_reports")
REPORT_MD = REPORT_DIR / "geography_dq_report.md"
ISSUES_CSV = REPORT_DIR / "geography_dq_issues.csv"

PRIMARY_KEY = "zip"
VALID_REGION = {"East", "Central", "West"}
ZIP_LEN = 5

lines: list[str] = []


def log(text: str = "") -> None:
    print(text)
    lines.append(text)


def section(title: str) -> None:
    log()
    log(f"## {title}")
    log()


def check_zip_key(df: pd.DataFrame) -> pd.DataFrame:
    section("1. Kiem tra cot zip (dinh dang & khoa chinh)")
    zip_str = df["zip"].astype(str).str.zfill(ZIP_LEN)
    bad_len = zip_str.str.len().ne(ZIP_LEN)
    null = df["zip"].isna()
    dup = df["zip"].duplicated(keep=False)
    log(f"- Tong so dong: {len(df)} | So zip distinct: {df['zip'].nunique()}")
    log(f"- So dong zip NULL: {int(null.sum())}")
    log(f"- So dong zip trung lap: {int(dup.sum())}")
    log(f"- So dong zip sai dinh dang (khong du {ZIP_LEN} ky tu): {int(bad_len.sum())}")
    verdict = "DAT" if null.sum() == 0 and dup.sum() == 0 else "KHONG DAT"
    log(f"> Ket luan: zip {verdict} dieu kien khoa chinh cua bang tra cuu.")
    bad = df[null | dup]
    return pd.DataFrame({"check": "zip_key_issue", "column": "zip",
                          PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad["zip"], "note": "NULL/trung lap"})


def check_region(df: pd.DataFrame) -> pd.DataFrame:
    section("2. Kiem tra cot region")
    vc = df["region"].value_counts(dropna=False)
    log(vc.rename_axis("region").reset_index(name="so_dong").to_markdown(index=False))
    invalid = df[~df["region"].isin(VALID_REGION)]
    log()
    log(f"- So dong ngoai domain hop le ({', '.join(VALID_REGION)}): {len(invalid)}")
    return pd.DataFrame({"check": "invalid_region", "column": "region",
                          PRIMARY_KEY: invalid[PRIMARY_KEY], "value": invalid["region"],
                          "note": "Ngoai domain hop le"})


def check_district(df: pd.DataFrame) -> pd.DataFrame:
    section("3. Kiem tra cot district")
    district_no = pd.to_numeric(df["district"].str.extract(r"(\d+)")[0], errors="coerce")
    bad = df["district"].isna() | district_no.isna()
    log(f"- So dong district NULL: {int(df['district'].isna().sum())}")
    log(f"- So dong khong tach duoc so district: {int(district_no.isna().sum())}")
    log(f"- Khoang so district: {int(district_no.min())} - {int(district_no.max())}")
    log(f"- So district distinct: {district_no.nunique()}")
    bad_rows = df[bad]
    return pd.DataFrame({"check": "invalid_district", "column": "district",
                          PRIMARY_KEY: bad_rows[PRIMARY_KEY], "value": bad_rows["district"],
                          "note": "NULL hoac khong tach duoc so"})


def check_zip_consistency(df: pd.DataFrame) -> pd.DataFrame:
    section("4. Kiem tra 1 zip co anh xa toi nhieu city/region khong")
    multi_city = df.groupby("zip")["city"].nunique()
    multi_region = df.groupby("zip")["region"].nunique()
    bad_zips = multi_city[multi_city > 1].index.union(multi_region[multi_region > 1].index)
    log(f"- So zip anh xa >1 city: {int((multi_city > 1).sum())}")
    log(f"- So zip anh xa >1 region: {int((multi_region > 1).sum())}")
    log("> Bang tra cuu can moi zip chi thuoc dung 1 city / 1 region; neu >1 nghia la du lieu mau thuan.")
    bad = df[df["zip"].isin(bad_zips)]
    return pd.DataFrame({"check": "zip_multi_mapping", "column": "zip",
                          PRIMARY_KEY: bad[PRIMARY_KEY], "value": bad["city"] + " / " + bad["region"],
                          "note": "Zip anh xa nhieu city/region"})


def check_distinct(df: pd.DataFrame) -> None:
    section("5. Kiem tra cac gia tri rieng biet (distinct)")
    prof = pd.DataFrame({
        "cot": df.columns,
        "so_distinct": [df[c].nunique(dropna=False) for c in df.columns],
        "so_null": [int(df[c].isna().sum()) for c in df.columns],
    })
    log(prof.to_markdown(index=False))
    log()
    log(f"- So city distinct: {df['city'].nunique()} | So region distinct: {df['region'].nunique()}")


def check_missing_summary(df: pd.DataFrame) -> None:
    section("6. Tong hop missing values toan bang")
    log(df.isna().sum().rename("so_null").to_frame().to_markdown())


def main(bronze_path: Path = BRONZE_PATH) -> None:
    df = pd.read_csv(bronze_path, encoding="utf-8-sig")
    log(f"# BAO CAO CHAT LUONG DU LIEU - {bronze_path.name}")
    log()
    log(f"- Kich thuoc: {df.shape[0]} dong x {df.shape[1]} cot")
    log(f"- Ngay chay: {pd.Timestamp.today():%Y-%m-%d %H:%M}")

    i1 = check_zip_key(df)
    i2 = check_region(df)
    i3 = check_district(df)
    i4 = check_zip_consistency(df)
    check_distinct(df)
    check_missing_summary(df)

    non_empty = [x for x in [i1, i2, i3, i4] if len(x)]
    issues = pd.concat(non_empty, ignore_index=True) if non_empty else pd.DataFrame(columns=["check", PRIMARY_KEY])

    section("TONG HOP")
    if len(issues):
        log(issues.groupby("check").size().rename("so_dong_anh_huong").reset_index().to_markdown(index=False))
        log()
        log(f"- Tong so dong co it nhat 1 loi: {issues[PRIMARY_KEY].nunique()} / {len(df)} "
            f"({issues[PRIMARY_KEY].nunique() / len(df) * 100:.2f}%)")
    else:
        log("Khong phat hien loi nao.")

    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_MD.write_text("\n".join(lines), encoding="utf-8")
    issues.to_csv(ISSUES_CSV, index=False, encoding="utf-8-sig")
    print(f"\n-> Da ghi {REPORT_MD}\n-> Da ghi {ISSUES_CSV}")


if __name__ == "__main__":
    main()